# ══════════════════════════════════════════════════════════════════════════════
#  Concrete Anomaly Inspector — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to source control (it's in .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ── Model paths ───────────────────────────────────────────────────────────────
# Directory containing: best_unet.pth, best_classifier.pth,
#                        kmeans_stages.pkl, kmeans_scaler.pkl, kmeans_rank_map.json
MODELS_DIR=./saved_models/

# ── Roboflow (optional) ───────────────────────────────────────────────────────
# Leave ROBOFLOW_API_KEY blank to skip ROI detection and use the full image.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=concrete_detection/6

# ── Inference thresholds ──────────────────────────────────────────────────────
# U-Net binarisation threshold (0.0–1.0)
SEG_THRESHOLD=0.90

# Roboflow detection confidence threshold (0.0–1.0)
CONF_THRESHOLD=0.90

# Overlay the anomaly mask on the image in the inspection card (true/false)
SHOW_MASK=true
